def uninstall():
    if HYPRLAND_LUA.exists():
        text = HYPRLAND_LUA.read_text()
        if REQUIRE in text:
            HYPRLAND_LUA.write_text(re.sub(rf"^{re.escape(REQUIRE)}\n?", "", text, flags=re.M))
    CRT_LUA.unlink(missing_ok=True)
    THEME_HOOK.unlink(missing_ok=True)
    SHADER.unlink(missing_ok=True)
    write_passthrough()
    set_shader(PASSTHROUGH)
    print("uninstalled — knobs.json kept, so `crt install` picks up where you left off")


# ----------------------------------------------------------------------- show


def show(st):
    ch = resolve_channel(st["channel"])
    src = ""
    if st["channel"] == "auto":
        src = " (from the staged theme)" if ch else " (no theme staged — template colours)"
    print(f"  {'GLASS':<10} {'on' if st['on'] else 'off'}")
    for k in ("BARREL", "FADE", "TRACKING"):
        v = st["panel"].get(k, PANEL_DEFAULTS[k])
        print(f"  {k:<10} {v:.2f}   {round(v * 100):>3d}%")
    print(f"  {'CHANNEL':<10} {st['channel']}{src}")
    if st["service"]:
        print("\n  service panel:")
        for k in sorted(st["service"]):
            print(f"    {k:<14} {st['service'][k]}")
    print(f"\n  template {TEMPLATE}\n  state    {KNOBS}\n  shader   {SHADER}")


# ------------------------------------------------------------------------ cli


def main(argv):
    cmd = argv[0] if argv else "list"
    rest = argv[1:]

    if cmd in ("-h", "--help", "help"):
        print(__doc__.split("WHY THERE IS")[0].rstrip())
        return
    if cmd == "list":
        show(load())
        return
    if cmd == "install":
        # Installing on top of something that fights us produces a CRT that
        # works until a window moves. Say so and stop; `crt install --anyway`
        # is there for when you have read the reason and disagree.
        if any(c[0] == "fight" for c in conflicts()) and "--anyway" not in rest:
            doctor()
            print("crt: not installing over that. `crt install --anyway` overrides.",
                  file=sys.stderr)
            raise SystemExit(1)
        install()
        return
    if cmd == "uninstall":
        uninstall()
        return
    if cmd == "doctor":
        raise SystemExit(doctor())
    if cmd == "try":
        raise SystemExit(try_on())
    if cmd == "untry":
        raise SystemExit(untry())

    st = load()

    if cmd == "render":
        # No hyprctl side effects: the theme-switch hook calls this, and a
        # theme switch is already reloading Hyprland.
        render(st)
        return
    if cmd == "set":
        if not rest or len(rest) % 2:
            die("set wants KNOB VALUE pairs")
        valid = known_knobs(template())
        for k, v in zip(rest[::2], rest[1::2]):
            k = k.upper()
            try:
                fv = float(v)
            except ValueError:
                die(f"'{v}' is not a number")
            if k in PANEL:
                st["panel"][k] = max(0.0, min(1.0, fv))
                # Turning a macro takes back the constants it owns, so the dial
                # and the picture cannot disagree about who is in charge.
                for const in PANEL[k]:
                    st["service"].pop(const, None)
            elif k in valid or k == "ANIMATED":
                st["service"][k] = fv
            else:
                die(f"no such knob: {k} (`crt` to list)")
        commit(st)
        show(st)
        return
    if cmd == "channel":
        if not rest:
            print(st["channel"])
            return
        name = rest[0]
        resolve_channel(name)          # validates, or dies
        st["channel"] = name
        commit(st)
        show(st)
        return
    if cmd in ("on", "off"):
        st["on"] = cmd == "on"
        commit(st)
        print("glass on" if st["on"] else "glass lifted")
        return

    die(f"unknown command '{cmd}' — crt [list|set|channel|on|off|install|uninstall|render]")


if __name__ == "__main__":
    main(sys.argv[1:])
