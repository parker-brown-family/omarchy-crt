#!/usr/bin/env python3
"""crt — the front panel of the desktop's cathode ray tube.

    crt                        what every knob is set to right now
    crt set BARREL 0.7         turn a knob (repeat pairs for several)
    crt set SCAN 0.35 VIGN 0.2 service knobs take their raw shader names
    crt on / crt off           lift the glass off the screen

    crt quiet on|off           stop the band on monitors without focus
    crt passthrough            surfaces handed back untouched (they draw
    crt passthrough add <cls>  their own CRT — terminal-delight does)

    crt tubes                  give every visible surface its own tube, once
    crt tubes watch            and keep them true as windows and popups come
                               and go — without this the rects are a snapshot
                               and the next menu gets bent by the window under it

    crt doctor                 what else on this box wants the screen shader
    crt try                    test it WITHOUT installing — hyprctl only, no
                               file written under ~/.config/hypr
    crt untry                  put the previous shader back

    crt install                wire it into Hyprland (once)
    crt uninstall              take it back out
    crt render                 re-render from state (theme-switch hook calls this)

WHY THERE IS A RENDERER AT ALL. Hyprland screen shaders take no uniforms and
have no IPC to set one, so "changing a setting" means rewriting the shader's
const block and recompiling — a few milliseconds, no relogin. The mistake worth
not repeating is doing that rewrite IN PLACE: the file then carries both the
defaults and your settings, and the two can no longer be told apart. So the
template under this plugin is read-only, the settings live in

    $XDG_STATE_HOME/omarchy/crt/knobs.json

and the live shader in that same directory is a build output that can be
deleted at any time and rebuilt from those two.

TWO TIERS OF KNOB. The front panel is four dials, because a real set had four:
BARREL, FADE, TRACKING and SCANLINE each drive a group of shader constants.
Behind that, every one of the twenty-two constants is
reachable by its own name, and a service knob set by hand outranks the macro
that would otherwise cover it — until you turn that macro again.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy/crt"
KNOBS = STATE / "knobs.json"
TUBES = STATE / "tubes.glsl"
# The ignition/shutdown effects, one block of GLSL constants written by the
# watch for the ~0.3 s an arc is in flight and left at FX_COUNT 0 the rest of
# the time. Runtime-only, like TUBES: nothing here is ever committed.
FX = STATE / "fx.glsl"
PLUGIN = Path(__file__).resolve().parent
TEMPLATE = PLUGIN / "crt-glass.frag"
# The rendered shader lives in the plugin's OWN state directory, not in
# ~/.config/hypr/shaders/. That directory has two other owners already — the
# terminal-delight theme installs its per-window warp there, and td-tubes moves
# files in and out of it (see disabled-by-td-tubes/) — and a build output of
# ours sitting among them is one more thing for three parties to trip over.
# Hyprland takes an absolute path, so there was never a reason to share.
SHADER = STATE / "crt-glass.frag"
PASSTHROUGH = STATE / "passthrough.frag"
PREVIOUS = STATE / "previous-shader"
# Two paths holding identical bytes, used alternately. See swap_in().
SLOTS = (STATE / "crt-glass-a.frag", STATE / "crt-glass-b.frag")
WATCHER_PID = STATE / "watcher.pid"

# Every Hyprland event that can move, create or destroy a surface. The layer
# ones matter most and are the easiest to forget: a tray, a menu, a
# notification and the lock screen are all layer surfaces that exist for a few
# seconds, and a surface with no rect of its own is drawn through its
# neighbour's map — bent, offset and seamed. That is not a rare edge; it is
# every popup on the desktop.
WATCH_EVENTS = (
    "openwindow", "closewindow", "movewindow", "movewindowv2",
    "changefloatingmode", "fullscreen", "workspace", "workspacev2",
    "focusedmon", "monitoradded", "monitorremoved", "activewindowv2",
    "openlayer", "closelayer", "configreloaded",
)
HYPR = HOME / ".config/hypr"
CRT_LUA = HYPR / "crt.lua"
HYPRLAND_LUA = HYPR / "hyprland.lua"
THEME_HOOK = (
    Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
    / "omarchy/hooks/theme-set.d/crt-rerender.hook"
)
STAGED_COLORS = (
    Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
    / "omarchy/current/theme/colors.toml"
)

BEGIN = "-- >>> omarchy-crt (managed by `crt install`) >>>"
END = "-- <<< omarchy-crt <<<"
REQUIRE = 'require("hypr.crt")  -- omarchy-crt'


# ---------------------------------------------------------------- the panel
#
# Each macro spreads over a group of constants. The multipliers are chosen so
# that the DEFAULTS below reproduce the shipped template byte for byte — a
# fresh install renders exactly the shader the theme used to ship, and the
# dials start where that shader already was rather than at some round number
# nobody picked.

PANEL = {
    "BARREL":   {"TUBE_K1": 0.26, "TUBE_K2": 0.11},
    "FADE":     {"BLOOM": 0.55, "GLOW": 0.63, "VIGN": 0.50},
    "TRACKING": {"TRACKING": 1.00},
    "SCANLINE": {"SCAN": 1.00},
}
PANEL_DEFAULTS = {"BARREL": 0.55, "FADE": 0.64, "TRACKING": 0.60, "SCANLINE": 0.22}

# Motion costs Hyprland's damage tracking (the time uniform forces a full-screen
# redraw every frame), so the clock follows these three rather than being a
# fourth thing to remember.
MOTION = ("TRACKING", "FLICKER", "JIGGLE")

# THERE IS NO PHOSPHOR KNOB, AND THAT IS THE POINT.
#
# An earlier draft had a CHANNEL dial that switched between P1 green, P3 amber
# and a paper-white VDU. It went, because it made this plugin a third authority
# on the colour of a desktop that already has two: the Omarchy theme sets the
# palette, and Terminal Paint tints individual tiles. A dial that overrides both
# contradicts the argument this plugin is built on — that a lens is not a
# palette, and the optics have no business having an opinion about hue.
#
# So the phosphor is always the staged theme's `accent` and the glare its
# `bright_foreground`. Nothing to choose, nothing to get out of step.


def die(msg):
    print(f"crt: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --------------------------------------------------------------------- state


def load():
    st = {
        "panel": dict(PANEL_DEFAULTS),
        "service": {},
        "on": True,
        # Off. See the clock note in render() — this is the one default whose
        # cost is a red banner across the user's desktop.
        "animated": False,
        # Surfaces that draw their own picture and must be handed back
        # untouched. terminal-delight has a complete CRT per pane, so the
        # glass would be applied to it twice.
        "passthrough": ["terminal-delight"],
        # Stop the clock on monitors that do not have focus. A monitor with
        # nothing changing on it gets no frames, so the band strands
        # mid-screen until something else repaints it.
        "quietUnfocused": True,
    }
    if KNOBS.exists():
        try:
            got = json.loads(KNOBS.read_text())
        except (OSError, ValueError) as e:
            die(f"{KNOBS} is not readable JSON ({e}) — delete it to start over")
        for k in ("panel", "service"):
            if isinstance(got.get(k), dict):
                st[k].update(got[k])
        # An absent "on" is not "off": a state file written before the key
        # existed means nobody has said, and the glass stays where it was.
        if isinstance(got.get("on"), bool):
            st["on"] = got["on"]
        if isinstance(got.get("animated"), bool):
            st["animated"] = got["animated"]
        if isinstance(got.get("passthrough"), list):
            st["passthrough"] = [x for x in got["passthrough"] if isinstance(x, str)]
        if isinstance(got.get("quietUnfocused"), bool):
            st["quietUnfocused"] = got["quietUnfocused"]
    return st


def save(st):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = KNOBS.with_suffix(".json.new")
    tmp.write_text(json.dumps(st, indent=2, sort_keys=True) + "\n")
    tmp.replace(KNOBS)


# -------------------------------------------------------------------- colour


def hex_to_vec3(h):
    h = h.strip().lstrip("#")
    if not re.fullmatch(r"[0-9a-fA-F]{6}", h):
        die(f"'{h}' is not a #RRGGBB colour")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return r, g, b


def lift(rgb, t=0.55):
    """Toward white — a glare tint derived from a phosphor when none is given."""
    return tuple(c + (1.0 - c) * t for c in rgb)


def theme_colours():
    """PHOSPHOR and GLARE_TINT from whatever theme is staged right now.

    `accent` and `bright_foreground` are the two keys every one of the 22 stock
    Omarchy themes carries, which is what makes AUTO safe to default to. When
    no theme is staged at all the answer is not black — it is *unknown*, and
    the caller falls back to the template's own colours rather than inventing
    one.
    """
    if not STAGED_COLORS.exists():
        return None
    try:
        import tomllib
        doc = tomllib.loads(STAGED_COLORS.read_text())
    except Exception:
        return None
    accent = doc.get("accent")
    if not isinstance(accent, str):
        return None
    ph = hex_to_vec3(accent)
    bf = doc.get("bright_foreground")
    gl = hex_to_vec3(bf) if isinstance(bf, str) else lift(ph)
    return ph, gl




# --------------------------------------------------------------------- render


def template():
    if not TEMPLATE.exists():
        die(f"template missing at {TEMPLATE}")
    return TEMPLATE.read_text()


def known_knobs(text):
    return set(re.findall(r"^const float ([A-Z_0-9]+)\s*=", text, re.M))


def glsl(v):
    """A float literal GLSL will accept.

    GLSL ES has no implicit int-to-float conversion in a const initializer, so
    `const float SCAN = 0;` is a compile error while `= 0.0` is fine. Python's
    %g drops the decimal point on any whole number, which meant turning ANY
    knob to zero — far and away the most likely thing anyone does with a knob —
    produced a shader that would not compile. The validator caught it and left
    the previous shader in place, so nothing broke; the knob just did nothing,
    which is the worse failure of the two because it looks like the feature.
    """
    s = f"{float(v):.6g}"
    return s if any(c in s for c in ".eE") else s + ".0"


def expand(st):
    """panel macros -> shader constants, then service overrides on top."""
    out = {}
    for macro, group in PANEL.items():
        v = float(st["panel"].get(macro, PANEL_DEFAULTS[macro]))
        for const, scale in group.items():
            out[const] = round(v * scale, 4)
    out.update({k: float(v) for k, v in st["service"].items()})
    return out


def render(st, path=None):
    text = template()
    valid = known_knobs(text)

    for k, v in expand(st).items():
        if k not in valid:
            die(f"no such knob: {k}")
        text, n = re.subn(
            rf"^(const float {k}\s*=\s*)-?[0-9.]+(;.*)$",
            lambda m: f"{m.group(1)}{glsl(v)}{m.group(2)}",
            text, count=1, flags=re.M)
        if n != 1:
            die(f"could not set {k} in the template")

    # THE CLOCK IS A SWITCH, NOT A CONSEQUENCE, and it ships off.
    #
    # Deriving it from the motion values looks right and is wrong at exactly
    # the worst moment. The template ships TRACKING at 0.60 and FLICKER at
    # 0.35 with ANIMATED at 0 — motion fully configured and deliberately
    # frozen — because Hyprland refuses to keep damage tracking on for any
    # shader that so much as declares `uniform float time`, and puts a
    # three-line red banner across the desktop saying so. Deriving the clock
    # meant a first render turned it on, and a fresh install greeted the user
    # with that banner and a GPU redrawing the whole screen every frame.
    #
    # So it lives in state, defaults to off, and only a deliberate act raises
    # it: turning a motion knob above zero, or naming ANIMATED outright.
    animated = 1 if st.get("animated") else 0
    text = re.sub(r"^(#define ANIMATED\s+)[01]", rf"\g<1>{animated}", text, count=1, flags=re.M)

    # The phosphor is the staged theme's, or the template's own when no theme
    # is staged — which is unknown, not black, and so is left alone.
    ch = theme_colours()
    if ch is not None:
        ph, gl = ch
        text = re.sub(r"^(const vec3  PHOSPHOR   = )vec3\([^)]*\);",
                      rf"\g<1>vec3({ph[0]:.3f}, {ph[1]:.3f}, {ph[2]:.3f});",
                      text, count=1, flags=re.M)
        text = re.sub(r"^(const vec3  GLARE_TINT = )vec3\([^)]*\);",
                      rf"\g<1>vec3({gl[0]:.3f}, {gl[1]:.3f}, {gl[2]:.3f});",
                      text, count=1, flags=re.M)

    # Tubes are runtime state and live outside the template entirely.
    #
    # The block is checked before it is trusted. An empty or truncated
    # tubes.glsl spliced in verbatim takes `#define TUBE_COUNT` out of the
    # shader, which leaves `#if TUBE_COUNT > 0` dangling and the whole file
    # uncompilable — a state file half-written by a watcher would take the
    # glass down. It must at minimum define the count it is providing.
    if TUBES.exists():
        block = TUBES.read_text()
        if not re.search(r"^\s*#define TUBE_COUNT\s+\d+", block, re.M):
            print(f"warning: ignoring {TUBES} — it defines no TUBE_COUNT",
                  file=sys.stderr)
        elif not watcher_alive() and not os.environ.get("CRT_TUBES_ANYWAY"):
            # RECTS NOBODY IS KEEPING TRUE ARE WORSE THAN NO RECTS. Every
            # surface that appears after they were written — a tray, a menu, a
            # notification, the lock screen — has no rect of its own and is
            # drawn through whichever window it happens to sit over, bent and
            # seamed. Flat glass is merely less pretty; this is broken.
            print("warning: no tube watcher is running, so the rects in "
                  f"{TUBES} are a snapshot.\n"
                  "         Rendering flat glass instead — `crt tubes watch` "
                  "to keep them true.", file=sys.stderr)
        else:
            # A block that predates TUBE_PASS — anything not written by this
            # plugin, td-tubes' own output included — declares no such array,
            # and the shader references it. Supply zeros rather than refusing:
            # "nobody marked any surface for passthrough" is the correct
            # reading of a block that has no opinion, and it keeps every
            # existing writer working.
            if not re.search(r"#define TUBE_COUNT\s+0\b", block):
                n = int(re.search(r"#define TUBE_COUNT\s+(\d+)", block).group(1))
                zeros = ", ".join(["0"] * n)
                for name in ("TUBE_PASS", "TUBE_QUIET"):
                    if name in block:
                        continue
                    block = block.replace(
                        "#endif",
                        f"const int   {name}[TUBE_COUNT] = int[TUBE_COUNT](\n"
                        f"    {zeros}\n);\n#endif")
            text = re.sub(
                r"(// ---- TUBE DATA[^\n]*\n).*?(// ---- END TUBE DATA ----)",
                lambda m: m.group(1) + block.rstrip("\n") + "\n" + m.group(2),
                text, count=1, flags=re.S)

    # The ignition fx, spliced the same guarded way as the tubes — and, like
    # them, only trusted while a watcher is alive to keep them true, since an arc
    # is a 0.3 s thing no snapshot can own. At rest the watch leaves FX_COUNT 0
    # here, so a CLI render (a knob turn) splices a no-op. A block that fails to
    # define its count is ignored rather than allowed to break the #if.
    fx_active = False
    if FX.exists() and (watcher_alive() or os.environ.get("CRT_TUBES_ANYWAY")):
        fxblock = FX.read_text()
        if not re.search(r"^\s*#define FX_COUNT\s+\d+", fxblock, re.M):
            print(f"warning: ignoring {FX} — it defines no FX_COUNT", file=sys.stderr)
        else:
            fx_active = not re.search(r"#define FX_COUNT\s+0\b", fxblock)
            text = re.sub(
                r"(// ---- FX DATA[^\n]*\n).*?(// ---- END FX DATA ----)",
                lambda m: m.group(1) + fxblock.rstrip("\n") + "\n" + m.group(2),
                text, count=1, flags=re.S)

    # A flash needs the clock, so an in-flight arc forces ANIMATED on regardless
    # of the stored flag — but only for as long as the arc lives. IGNITION is not
    # a MOTION knob, so it never latches the clock here; the fx count does, and
    # the expiry swap that drops the count takes the clock back out with it.
    if fx_active:
        text = re.sub(r"^(#define ANIMATED\s+)[01]", r"\g<1>1", text, count=1, flags=re.M)

    out = Path(path) if path else SHADER
    out.parent.mkdir(parents=True, exist_ok=True)

    # Validate a scratch copy BEFORE it can reach the live compositor. A knob
    # that does not compile leaves the previous shader exactly where it was.
    if shutil.which("glslangValidator"):
        with tempfile.NamedTemporaryFile("w", suffix=".frag", delete=False) as f:
            f.write(text)
            probe = f.name
        try:
            r = subprocess.run(["glslangValidator", probe],
                               capture_output=True, text=True)
            if r.returncode != 0:
                die("that does not compile — nothing applied\n" + r.stdout + r.stderr)
        finally:
            os.unlink(probe)
    else:
        print("warning: glslangValidator not installed; applying unvalidated",
              file=sys.stderr)

    out.write_text(text)
    if out == SHADER:
        publish(st, text)
    return out


def publish(st, text):
    """Write what was actually compiled, for anything that draws a UI.

    knobs.json is what you asked for; live.json is what the glass is. They are
    different documents and conflating them is how a dial ends up showing a
    setting that never reached the screen — AUTO with no theme staged resolves
    to no colour at all, and a panel reading the request would happily draw the
    theme's accent over a shader that is still using the template's.
    """
    ch = theme_colours()
    consts = {m.group(1): float(m.group(2))
              for m in re.finditer(r"^const float ([A-Z_0-9]+)\s*=\s*(-?[0-9.]+)", text, re.M)}
    animated = re.search(r"^#define ANIMATED\s+([01])", text, re.M)
    tubes = re.search(r"^#define TUBE_COUNT\s+(\d+)", text, re.M)
    fx = re.search(r"^#define FX_COUNT\s+(\d+)", text, re.M)

    def hexof(group):
        m = re.search(rf"^const vec3  {group} += vec3\(([^)]*)\);", text, re.M)
        if not m:
            return None
        r, g, b = (float(x) for x in m.group(1).split(","))
        return "#%02X%02X%02X" % tuple(round(c * 255) for c in (r, g, b))

    doc = {
        "on": st["on"],
        # null when no theme is staged to take a colour from. Null is not
        # black here: it is "nobody said", and the panel says so.
        "phosphorFrom": "theme" if ch else None,
        "phosphor": hexof("PHOSPHOR"),
        "glare": hexof("GLARE_TINT"),
        "animated": int(animated.group(1)) if animated else 0,
        # How many tiles are wearing their own tube. Zero means the glass is
        # one flat sheet over the desktop, which is a different picture and
        # worth saying out loud rather than leaving the reader to wonder why
        # nothing is curved.
        "tubes": int(tubes.group(1)) if tubes else 0,
        # Arcs in flight this instant — almost always 0, briefly 1+ while a
        # window fires up or goes dark. A UI can show the knob is doing
        # something without polling the shader.
        "fx": int(fx.group(1)) if fx else 0,
        "panel": {k: st["panel"].get(k, PANEL_DEFAULTS[k]) for k in PANEL_DEFAULTS},
        "consts": consts,
        "shader": str(SHADER),
    }
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "live.json.new"
    tmp.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    tmp.replace(STATE / "live.json")


# --------------------------------------------------------------------- hypr


def hyprctl(*args):
    if not shutil.which("hyprctl"):
        return None
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def set_shader(path):
    """Hyprland 0.56's Lua config retired `hyprctl keyword` — and it fails
    SOFTLY, printing a line and changing nothing, so a redirect to /dev/null
    reads as success. Try keyword for older builds, detect the refusal in its
    output, and drive hl.config through eval where the config is Lua."""
    out = hyprctl("keyword", "decoration:screen_shader", str(path))
    if out is not None and "non-legacy" in out:
        hyprctl("eval", f'hl.config({{ decoration = {{ screen_shader = "{path}" }} }})')


def write_passthrough():
    """screen_shader cannot be turned OFF — assigning "" leaves whatever path
    was in effect. Off therefore means pointing at a shader that does nothing,
    and that shader has to exist or every render re-stats a missing path and
    Hyprland raises it in the persistent error bar (screencopy included, so
    every screenshot trips it)."""
    if PASSTHROUGH.exists():
        return
    PASSTHROUGH.parent.mkdir(parents=True, exist_ok=True)
    PASSTHROUGH.write_text(
        "#version 320 es\n"
        "// omarchy-crt — plain glass. `crt off` points here, because Hyprland\n"
        "// has no way to unset a screen shader.\n"
        "precision highp float;\n"
        "in vec2 v_texcoord;\n"
        "uniform sampler2D tex;\n"
        "out vec4 fragColor;\n"
        "void main() { fragColor = texture(tex, v_texcoord); }\n")


# ------------------------------------------------------------------- tubes
#
# A tube is one surface's rectangle, and the shader bends each pixel through
# whichever rect contains it. The invariant that makes that safe is that EVERY
# visible surface claims its own rect — a region nobody claims falls through to
# whatever rect is underneath and gets drawn through a neighbour's map.
#
# Which means a snapshot is not a weaker version of a registry, it is a broken
# one. Layer surfaces come and go constantly: a tray, a menu, a notification,
# the lock screen. None of them can appear in a list taken before they existed,
# so each one gets bent by the window beneath it the moment it opens. The rects
# must track the compositor or they must not be used at all, and there is no
# guard that substitutes for watching.
#
# The geometry itself is not reimplemented here and not fetched from anywhere
# at runtime either. crt/tubes-geometry is a GENERATED copy of the theme's
# td-tubes — rotation transforms, per-monitor scale, layer surfaces, the
# fullscreen occlusion rule, the whole-monitor budget — produced by
# bin/sync-tubes-geometry, which is the only way it changes. The theme's file
# stays the single place the geometry is edited; the plugin stands alone.
GEOMETRY = PLUGIN / "tubes-geometry"


def td_tubes_snapshot(passthrough=(), quiet_unfocused=True):
    """The current TUBE block AND the capped rows behind it, or (None, None).

    One geometry run yields both. The GLSL block is exactly what td_tubes_block
    always returned — the rect list with TUBE_PASS/TUBE_QUIET added. The rows are
    the same capped surfaces as JSON objects, each carrying its window `addr`, so
    the ignition watch can match a socket2 open/close event to the rect that was
    there. Sharing one run keeps block and rows in lockstep and pays hyprctl once.

    The geometry emits a `// <class>` comment on every rect line, which is what
    lets the passthrough list be written in terms of window classes rather than
    indices into a list that changes every time a window opens.
    """
    if not GEOMETRY.exists():
        return None, None
    # Compute the capped rects ONCE, then print them as JSON and as the baked
    # block either side of a marker — two views of one measurement.
    r = subprocess.run(
        ["bash", "-c",
         f'source "{GEOMETRY}"; j="$(cap "$(tubes_json)")"; '
         f'printf %s "$j"; printf "\\n===CRT-BLOCK===\\n"; emit_block "$j"'],
        capture_output=True, text=True)
    if r.returncode != 0 or "===CRT-BLOCK===" not in r.stdout:
        return None, None
    json_part, _, block_raw = r.stdout.partition("\n===CRT-BLOCK===\n")
    if "#define TUBE_COUNT" not in block_raw:
        return None, None
    try:
        rows = json.loads(json_part)
        if not isinstance(rows, list):
            rows = []
    except ValueError:
        rows = []

    # Strip td-tubes' own markers; render() supplies its own.
    body = re.sub(r"^// ---- TUBE DATA[^\n]*\n", "", block_raw)
    body = re.sub(r"// ---- END TUBE DATA ----\n?$", "", body)

    n = int(re.search(r"#define TUBE_COUNT\s+(\d+)", body).group(1))
    if n == 0:
        return body, rows

    classes = re.findall(r"^\s*vec4\([^)]*\),?\s*//\s*(.+?)\s*$", body, re.M)
    if len(classes) != n:
        # No class comments to key on, so nothing can be opted out — which is
        # the old behaviour, not a failure. Say nothing and carry on.
        classes = [""] * n
    flags = ", ".join("1" if c in passthrough else "0" for c in classes)

    # A tube on a monitor without focus goes quiet: that monitor usually stops
    # being rendered, and a clock that never advances leaves the band stranded.
    # An unknown focus silences nothing — see focused_monitor().
    mons = re.search(r"TUBE_MON\[TUBE_COUNT\]\s*=\s*\w+\[TUBE_COUNT\]\(([^)]*)\)",
                     body, re.S)
    fm = focused_monitor() if quiet_unfocused else None
    if mons and fm is not None:
        ids = [v.strip() for v in mons.group(1).split(",")]
        quiet = ", ".join("0" if v == str(fm) else "1" for v in ids)
    else:
        quiet = ", ".join(["0"] * n)

    block = body.replace(
        "#endif",
        f"const int   TUBE_PASS[TUBE_COUNT] = int[TUBE_COUNT](\n    {flags}\n);\n"
        f"const int   TUBE_QUIET[TUBE_COUNT] = int[TUBE_COUNT](\n    {quiet}\n);\n#endif")
    return block, rows


def td_tubes_block(passthrough=(), quiet_unfocused=True):
    """The current rect block alone, or None — td_tubes_snapshot without rows.
    Kept for the callers (tubes_once, the geometry-missing checks) that never
    needed the rows."""
    block, _ = td_tubes_snapshot(passthrough, quiet_unfocused)
    return block


def focused_monitor():
    """Which monitor has focus, or None when it cannot be established.

    None is not "monitor 0" — it means nobody said, and the caller leaves every
    tube performing rather than silencing the wrong screen on a guess.
    """
    out = hyprctl("monitors", "-j")
    if not out:
        return None
    try:
        for m in json.loads(out):
            if m.get("focused"):
                return int(m["id"])
    except (ValueError, KeyError, TypeError):
        return None
    return None


def watcher_alive():
    """Is something keeping the rects in step with the compositor right now?"""
    try:
        pid = int(WATCHER_PID.read_text().strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def write_tubes(block):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "tubes.glsl.new"
    tmp.write_text(block)
    tmp.replace(TUBES)


# ---- ignition/shutdown fx ---------------------------------------------------
#
# A window opening or closing fires its tube: the arc in crt-glass.frag's
# fx_pattern, ported from terminal-delight. The shader draws it; this half
# decides WHICH rect fires, WHEN, and keeps arcs alive across the shader
# rebuilds that other events trigger. The whole feature is off unless the
# IGNITION knob is above zero, and every arc lasts FX_S seconds.
FX_S    = 0.30   # arc length, matched to crt-glass.frag's FX_S / crt.rs IGNITION_MS
FX_PAD  = 0.05   # grace past FX_S before an entry is pruned
FX_LEAD = 0.03   # start each arc this far in, to eat the compile+swap latency
FX_MAX  = 8      # most arcs baked at once; a storm keeps the newest


def ignition_level(st):
    """The IGNITION knob, 0 when unset. A service constant, deliberately NOT a
    member of MOTION — turning it up must never latch the steady-state clock."""
    try:
        return float(st.get("service", {}).get("IGNITION", 0.0))
    except (TypeError, ValueError):
        return 0.0


def norm_addr(a):
    """A Hyprland window address, comparable across sources. socket2 events name
    a window as `55d7…`; hyprctl reports `0x55d7…`. Strip the prefix, lowercase,
    so the two always meet."""
    a = (a or "").strip().lower()
    return a[2:] if a.startswith("0x") else a


def rows_by_addr(rows):
    return {norm_addr(r.get("addr")): r for r in rows if r.get("addr")}


def fx_eligible(row, st, focused):
    """Does this surface get a flash? A tube that opts out of the warp
    (curvature 0) is not pretending to be a CRT — flat layers and, deliberately,
    terminal-delight, which plays its own per-pane ignition. A passthrough class
    hands its pixels back before the fx loop could paint them. And on a quiet
    (unfocused) monitor the clock is frozen, so an arc there would strand
    mid-flight — the same reason TUBE_QUIET exists."""
    try:
        if float(row.get("curv", 0)) <= 0.0:
            return False
    except (TypeError, ValueError):
        return False
    if row.get("class") in st.get("passthrough", []):
        return False
    if st.get("quietUnfocused", True) and focused is not None:
        if row.get("mon") != focused:
            return False
    return True


def _fx_entry(kind, row, now):
    """An fx table entry from a geometry row. The rect is the window's own, in
    the same framebuffer space the tube used, so the flash lands exactly where
    the tube was — captured now, because a closing window's rect is gone from
    the next snapshot."""
    return {
        "kind": kind,
        "mon": int(row.get("mon", 0)),
        "rect": (float(row["x"]), float(row["y"]), float(row["w"]), float(row["h"])),
        "curv": float(row.get("curv", 1) or 1),
        "t0": now,
    }


def fx_sig(fx):
    """What has to change before an fx bake is worth a recompile. Everything
    that defines an arc EXCEPT its baked FX_START offset — the offset is
    recomputed on every bake by construction, so hashing it would make every
    bake differ from the last and the watch would rebuild without end. The live
    offsets stay correct while nothing rebuilds because the live clock keeps
    running; a rebuild only has to happen when an arc appears, ends, or its rect
    moves, none of which this signature can miss."""
    return tuple(sorted(
        (a, e["kind"], e["mon"], tuple(e["rect"]), round(e["t0"], 3))
        for a, e in fx.items()))


def fx_tint():
    """The flash colour: the staged theme's phosphor, white when no theme is
    staged (never the template's baked green over a foreign theme). The seam a
    later per-terminal tint from Terminal Paint plugs into, by address."""
    ch = theme_colours()
    return ch[0] if ch else (1.0, 1.0, 1.0)


def write_fx(fx, now):
    """The FX DATA block for the arcs in flight. FX_START is negative seconds:
    -(elapsed + lead), so an arc re-baked mid-flight keeps its place instead of
    restarting when the shader's clock is reset by the swap, and a fresh arc
    starts a hair early to cover the compile+swap latency."""
    STATE.mkdir(parents=True, exist_ok=True)
    items = sorted(fx.items(), key=lambda kv: kv[1]["t0"])
    n = len(items)
    # Markerless, like tubes.glsl: render() owns the FX DATA markers and splices
    # this body between them.
    lines = [f"#define FX_COUNT {n}"]
    if n:
        tint = fx_tint()
        rects = ", ".join(
            f"vec4({glsl(e['rect'][0])}, {glsl(e['rect'][1])}, "
            f"{glsl(e['rect'][2])}, {glsl(e['rect'][3])})" for _, e in items)
        mons  = ", ".join(str(int(e["mon"])) for _, e in items)
        curvs = ", ".join(glsl(e["curv"]) for _, e in items)
        starts = ", ".join(glsl(min(0.0, -((now - e["t0"]) + FX_LEAD))) for _, e in items)
        kinds = ", ".join(str(int(e["kind"])) for _, e in items)
        tints = ", ".join(
            f"vec3({glsl(tint[0])}, {glsl(tint[1])}, {glsl(tint[2])})" for _ in items)
        lines += [
            "#if FX_COUNT > 0",
            f"const vec4  FX_RECT[FX_COUNT]  = vec4[FX_COUNT]({rects});",
            f"const int   FX_MON[FX_COUNT]   = int[FX_COUNT]({mons});",
            f"const float FX_CURV[FX_COUNT]  = float[FX_COUNT]({curvs});",
            f"const float FX_START[FX_COUNT] = float[FX_COUNT]({starts});",
            f"const int   FX_KIND[FX_COUNT]  = int[FX_COUNT]({kinds});",
            f"const vec3  FX_TINT[FX_COUNT]  = vec3[FX_COUNT]({tints});",
            "#endif"]
    tmp = STATE / "fx.glsl.new"
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(FX)


def tubes_once():
    st = load()
    block = td_tubes_block(st.get("passthrough", []), st.get("quietUnfocused", True))
    if block is None:
        die(f"geometry missing at {GEOMETRY} — run bin/sync-tubes-geometry (glass stays flat)")
    write_tubes(block)
    apply(st)
    n = re.search(r"#define TUBE_COUNT\s+(\d+)", block)
    print(f"{n.group(1) if n else '?'} tube(s)")
    if not watcher_alive():
        print("  no watcher is running, so these rects are a SNAPSHOT and the next")
        print("  popup gets bent by the window under it. `crt tubes watch`.")


def tubes_watch():
    """Follow the compositor and keep the rects true until interrupted."""
    if td_tubes_block() is None:
        die(f"geometry missing at {GEOMETRY} — run bin/sync-tubes-geometry")

    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR")
    if not sig or not rt:
        die("no Hyprland session in this environment")
    sock_path = Path(rt) / "hypr" / sig / ".socket2.sock"
    if not sock_path.exists():
        die(f"no event socket at {sock_path}")

    import socket as _socket
    import select as _select
    import time as _time

    STATE.mkdir(parents=True, exist_ok=True)
    WATCHER_PID.write_text(str(os.getpid()) + "\n")

    def flatten(*_):
        # Leaving the last rects behind on the way out is the snapshot bug with
        # extra steps, so the glass goes flat when the watch stops — and any arc
        # in flight is cleared with it, so no half-finished flash can outlive the
        # process that promised to complete it.
        write_tubes("#define TUBE_COUNT 0\n")
        write_fx({}, _time.monotonic())
        try:
            apply(load())
        except SystemExit:
            pass
        WATCHER_PID.unlink(missing_ok=True)
        raise SystemExit(0)

    import signal
    signal.signal(signal.SIGTERM, flatten)
    signal.signal(signal.SIGINT, flatten)

    last = None
    last_fx = None
    fx = {}            # addr -> {kind, mon, rect, curv, t0}
    addr_rows = {}     # addr -> row, from the PREVIOUS snapshot: the only place
                       # a window that just closed still has a rectangle.

    def refresh(why, data=""):
        nonlocal last, last_fx, addr_rows, fx
        stw = load()
        block, rows = td_tubes_snapshot(stw.get("passthrough", []),
                                        stw.get("quietUnfocused", True))
        if block is None:
            return
        now = _time.monotonic()

        # The fx feature is live only with the knob up and geometry new enough to
        # carry window addresses; without addresses a close event cannot be tied
        # to the rect that vanished, so rather than guess, fx stays dark.
        level = ignition_level(stw)
        have_addr = any(r.get("addr") for r in rows)
        fx_on = level > 0.0 and have_addr
        if level > 0.0 and not have_addr and os.environ.get("CRT_WATCH_DEBUG"):
            print("crt: IGNITION set but geometry has no addr field — "
                  "run bin/sync-tubes-geometry; fx disabled", flush=True)

        if fx_on:
            focused = focused_monitor()
            if why == "closewindow":
                row = addr_rows.get(norm_addr(data))
                if row and fx_eligible(row, stw, focused):
                    fx[norm_addr(data)] = _fx_entry(1, row, now)
            elif why == "openwindow":
                a = norm_addr(data.split(",", 1)[0])
                row = rows_by_addr(rows).get(a)
                if row and fx_eligible(row, stw, focused):
                    fx[a] = _fx_entry(0, row, now)
            # Drop arcs whose time is up, and if a storm of events outran the
            # budget, keep the newest — a flash you cannot see is not worth a
            # slot in the array the shader loops over every pixel.
            for a in [a for a, e in fx.items() if now - e["t0"] > FX_S + FX_PAD]:
                del fx[a]
            if len(fx) > FX_MAX:
                for a, _ in sorted(fx.items(), key=lambda kv: kv[1]["t0"])[:-FX_MAX]:
                    del fx[a]
        elif fx:
            fx = {}

        # The previous snapshot's rects, for the NEXT close event to look up in.
        addr_rows = rows_by_addr(rows)

        key, sigfx = block_key(block), fx_sig(fx)
        if key == last and sigfx == last_fx:
            if os.environ.get("CRT_WATCH_DEBUG"):
                print(f"crt: (no change)  <- {why}", flush=True)
            return
        last, last_fx = key, sigfx
        write_tubes(block)
        write_fx(fx, now)
        apply(load())
        n = re.search(r"#define TUBE_COUNT\s+(\d+)", block)
        note = f"  fx={len(fx)}" if (fx or last_fx) else ""
        print(f"crt: {n.group(1) if n else '?'} tube(s){note}  <- {why}", flush=True)

    print(f"crt: watching {sock_path} (ctrl-c to stop)", flush=True)
    refresh("start")

    s = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
    s.connect(str(sock_path))
    buf = b""
    try:
        while True:
            # When arcs are in flight, wake at the moment the oldest one ends
            # even if no event arrives — that expiry is what swaps the still
            # glass back and takes the clock (and its full-screen redraw) with
            # it. With nothing in flight, block until the compositor speaks.
            timeout = None
            if fx:
                oldest = min(e["t0"] for e in fx.values())
                timeout = max(0.0, oldest + FX_S + FX_PAD - _time.monotonic())
            ready, _, _ = _select.select([s], [], [], timeout)
            if not ready:
                refresh("fx-expiry")
                continue
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                decoded = line.decode("utf-8", "replace")
                name, _, data = decoded.partition(">>")
                # A reload is not a change, it is AMNESIA: Hyprland re-reads
                # its config and drops everything set at runtime — the screen
                # shader binding and both preconditions. "Did any rect move"
                # is therefore the wrong question on this one event; the
                # answer is usually no, the skip left the desktop flat, and
                # the glass only came back when the mouse happened to cross
                # monitors and flip the quiet flags. Forgetting `last` makes
                # the next refresh restate the world unconditionally —
                # shader, preconditions, and a phosphor re-read from the
                # freshly staged theme, which is the other thing a theme
                # switch changes without moving a single window.
                if name == "configreloaded":
                    last = None
                if name in WATCH_EVENTS:
                    refresh(name, data)
    finally:
        flatten()


def live_shader():
    """What decoration:screen_shader is set to right now, or None."""
    out = hyprctl("getoption", "decoration:screen_shader")
    if not out:
        return None
    m = re.search(r"^str:\s*(\S.*?)\s*$", out, re.M)
    return m.group(1) if m and m.group(1) not in ("", "[[EMPTY]]") else None


def conflicts():
    """Everything on this box that also wants to own the screen shader.

    Returns a list of (severity, headline, detail). Severity 'fight' means it
    will actively take the shader back off us while we are using it; 'reload'
    means it wins only at the next Hyprland config reload; 'note' is context.

    This exists because the failure it describes is invisible. Two owners
    re-pointing the same setting does not error — it produces a CRT that works
    until you move a window, which reads as a flaky plugin rather than as two
    programs disagreeing.
    """
    out = []

    unit = subprocess.run(["systemctl", "--user", "is-active", "td-tubes.service"],
                          capture_output=True, text=True).stdout.strip() \
        if shutil.which("systemctl") else ""
    if unit == "active":
        out.append(("fight", "td-tubes.service is running",
                    "It re-applies decoration:screen_shader on every Hyprland layout "
                    "event, pointing at the staged theme's crt-glass.frag. It will "
                    "take the shader back the moment a window moves.\n"
                    "    stop it:  systemctl --user stop td-tubes.service\n"
                    "    later:    systemctl --user start td-tubes.service"))

    looknfeel = HYPR / "looknfeel.lua"
    if looknfeel.exists() and "screen_shader" in looknfeel.read_text():
        out.append(("reload", "looknfeel.lua sets screen_shader",
                    "The terminal-delight theme's managed block. It wins at the next "
                    "Hyprland reload unless hypr.crt is required after it, which is "
                    "what `crt install` arranges. `crt try` does not touch it."))

    if STAGED_COLORS.parent.joinpath("crt-glass.frag").exists():
        out.append(("note", "the staged theme ships its own crt-glass.frag",
                    "So the theme's CRT is installed and available. Nothing here "
                    "overwrites it; the two are separate files with separate knobs."))

    now = live_shader()
    if now:
        who = ("this plugin" if str(SHADER) == now
               else "the theme" if "current/theme" in now
               else "passthrough" if "passthrough" in now
               else "something else")
        out.append(("note", f"screen_shader is currently {who}", f"    {now}"))

    if HYPRLAND_LUA.exists() and REQUIRE in HYPRLAND_LUA.read_text():
        out.append(("note", "hypr.crt is wired into hyprland.lua",
                    "`crt install` has been run. `crt uninstall` takes it back out."))

    return out


def doctor():
    found = conflicts()
    fights = [c for c in found if c[0] == "fight"]

    # Persist it, so the bar widget can say WHY it did not wire itself in. A
    # widget that silently does nothing on first open is indistinguishable from
    # a broken install, and the reason is two directories away in a terminal
    # the user is not looking at.
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "doctor.json.new"
    tmp.write_text(json.dumps(
        {"blocked": bool(fights),
         "findings": [{"severity": s, "headline": h, "detail": d} for s, h, d in found]},
        indent=2) + "\n")
    tmp.replace(STATE / "doctor.json")

    print("crt doctor\n")
    if not found:
        print("  nothing else on this box wants the screen shader.")
    for sev, head, detail in found:
        mark = {"fight": "FIGHT", "reload": "wins at reload", "note": "note"}[sev]
        print(f"  [{mark}] {head}")
        for line in detail.splitlines():
            print(f"    {line}" if not line.startswith("    ") else line)
        print()
    if fights:
        print("  Something will take the shader back off you while you are using it.")
        print("  Park it first, or the CRT will look intermittent rather than wrong.")
    return 1 if fights else 0


def try_on():
    """Test the glass without installing anything.

    Renders, remembers whatever screen_shader was pointing at, and re-points it
    at us — through hyprctl only. No hyprland.lua edit, no crt.lua, no
    theme-set hook, nothing written under ~/.config/hypr at all. A Hyprland
    reload undoes it on its own, and `crt untry` undoes it now.
    """
    found = conflicts()
    for sev, head, detail in found:
        if sev == "fight":
            print(f"crt: {head} — it will take the shader back on the next layout event.",
                  file=sys.stderr)
            for line in detail.splitlines():
                print(f"  {line}", file=sys.stderr)
            print("\ncrt: refusing to try over it. Park it, then run `crt try` again.",
                  file=sys.stderr)
            return 1

    st = load()
    write_passthrough()
    render(st)
    before = live_shader()
    STATE.mkdir(parents=True, exist_ok=True)
    PREVIOUS.write_text((before or "") + "\n")
    set_shader(SHADER)
    print(f"trying {SHADER}")
    print(f"  was:  {before or '(nothing set)'}")
    print("  nothing was written under ~/.config/hypr — `crt untry` or a Hyprland")
    print("  reload puts it back.")
    return 0


def untry():
    before = PREVIOUS.read_text().strip() if PREVIOUS.exists() else ""
    if before:
        set_shader(before)
        print(f"put back: {before}")
    else:
        write_passthrough()
        set_shader(PASSTHROUGH)
        print("nothing was set before — pointed at the passthrough")
    PREVIOUS.unlink(missing_ok=True)
    return 0


def commit(st):
    """Render first, save only if it rendered.

    The order matters more than it looks. Validating the shader stops a bad
    value reaching the compositor, but if the value has already been written to
    knobs.json it has reached something worse: `crt set GAMMA 0` used to save,
    then fail to compile, then fail to compile on every later command too —
    the tool bricked itself over one typo and the only way out was deleting a
    file nobody mentions. A setting that was refused was never a setting.
    """
    apply(st)
    save(st)


def preconditions(animated, tube_count):
    """Two compositor settings the glass does not work without.

    THE CURSOR HAS TO RIDE THE SHADER. `cursor:no_hardware_cursors` defaults to
    2, which lets Hyprland put the pointer on a hardware plane — composited by
    the display controller, after and outside everything this shader does. The
    picture then bends and the pointer does not, so what you see under the
    cursor near a tile's corner is up to ~4% of the tile away from what you are
    actually pointing at. It reads as a hover bug and it is not: it is the
    cursor being the one thing on screen the glass never touched.

    NO STALE PIXELS UNDER A GATHER. `debug:damage_tracking` must be 0 because
    this shader reads neighbouring pixels — Hyprland repainting only the small
    rect the cursor dirtied leaves the gather sampling last frame's pixels
    around it, which reads as tearing under mouse movement specifically.

    Damage tracking has three tiers, and the gather does not need the dearest
    one. 0 redraws everything every frame — the price the clock demands, and
    the one the red banner names. 1 redraws the WHOLE MONITOR whenever
    anything on it changes, and nothing when nothing does: a damaged frame is
    repainted entire, so the gather never samples a stale neighbour, while an
    idle monitor draws no frames at all. That is everything the tubes need.
    The doctrine inherited from td-tubes set 0 for the gather, paying the
    every-frame price for a correctness that tier 1 already buys.

    So: the clock costs 0 (Hyprland insists, in red, across the desktop), a
    still glass with tubes costs 1, and bare glass costs nothing at all.

    All runtime-only, so a `hyprctl reload` drops them; the watch re-asserts
    on configreloaded.
    """
    if animated:
        want_damage = "0"
    elif tube_count > 0:
        want_damage = "1"
    else:
        want_damage = "2"
    want_cursor = "1" if tube_count > 0 else "2"
    out = hyprctl("keyword", "debug:damage_tracking", want_damage)
    legacy_gone = out is not None and "non-legacy" in out
    if legacy_gone:
        hyprctl("eval", f"hl.config({{ debug = {{ damage_tracking = {want_damage} }} }})")
    else:
        hyprctl("keyword", "cursor:no_hardware_cursors", want_cursor)
        return
    hyprctl("eval",
            f"hl.config({{ cursor = {{ no_hardware_cursors = {want_cursor} }} }})")


def swap_in(built):
    """Point Hyprland at the new shader with no flat frame in between.

    Hyprland will not recompile a path it is already using, so a rebuild has to
    arrive under a DIFFERENT path. Doing that by setting the passthrough shader
    first and ours second is two compositor states, and the first of them is the
    glass switched off — one flat frame, every time, which on a watcher that
    fires whenever focus moves is a flash whenever you cross between windows.

    Two slots holding identical bytes solve it: write the build output to
    whichever slot is not live, point at that, and Hyprland compiles the new
    path and swaps. There is no moment where the desktop is unglassed.
    """
    now = live_shader()
    slot = SLOTS[1] if now == str(SLOTS[0]) else SLOTS[0]
    slot.write_bytes(built.read_bytes())
    set_shader(slot)


def _tube_rows(block):
    """(mon, x, y, w, h, curv, pass) per tube, or None if it cannot be read."""
    rects = re.findall(r"vec4\(\s*([-0-9.]+),\s*([-0-9.]+),\s*([-0-9.]+),\s*([-0-9.]+)\s*\)",
                       block)
    def ints(name):
        m = re.search(rf"{name}\[TUBE_COUNT\]\s*=\s*\w+\[TUBE_COUNT\]\(([^)]*)\)",
                      block, re.S)
        return [v.strip() for v in m.group(1).split(",")] if m else []
    mons, curvs, passes = ints("TUBE_MON"), ints("TUBE_CURV"), ints("TUBE_PASS")
    quiets = ints("TUBE_QUIET")
    if not rects or len(mons) != len(rects):
        return None
    if len(curvs) != len(rects):
        curvs = ["0"] * len(rects)
    if len(passes) != len(rects):
        passes = ["0"] * len(rects)
    if len(quiets) != len(rects):
        quiets = ["0"] * len(rects)
    # quiets is in the row, so moving focus to another monitor changes the key
    # and earns a rebuild — which is the frame that paints the wipe.
    return [(mons[i], *rects[i], curvs[i], passes[i], quiets[i])
            for i in range(len(rects))]


def block_key(block):
    """What actually has to change before the shader is worth rebuilding.

    td-tubes emits most-recently-focused first so an overlapping window takes
    the pixels it covers. That makes the ORDER meaningful only where rects
    overlap — and on a tiled monitor they never do, so exactly one rect can
    contain any pixel and the order carries nothing. Focusing another window
    rewrites the list without moving a single rectangle; comparing the ordered
    text made every one of those a shader recompile.
    """
    rows = _tube_rows(block)
    if rows is None:
        return block
    by_mon = {}
    for r in rows:
        by_mon.setdefault(r[0], []).append(tuple(float(v) for v in r[1:5]))
    for rs in by_mon.values():
        for i in range(len(rs)):
            for j in range(i + 1, len(rs)):
                ax, ay, aw, ah = rs[i]
                bx, by, bw, bh = rs[j]
                if ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah:
                    return block          # overlapping: order decides ownership
    return tuple(sorted(rows))


def apply(st):
    write_passthrough()
    out = render(st)
    if not shutil.which("hyprctl"):
        print(f"wrote {out} — applies at next login (hyprctl not found)")
        return
    # Re-setting the same path is a no-op, so drop and re-set to force a
    # recompile of the file we just changed. The clock state is read from the
    # RENDERED shader, not the stored flag, so an in-flight ignition arc (which
    # forces ANIMATED on for its 0.3 s) is paid for in damage tier while it
    # lasts and no longer once the expiry swap drops it.
    txt = out.read_text()
    n = re.search(r"#define TUBE_COUNT\s+(\d+)", txt)
    anim = re.search(r"^#define ANIMATED\s+([01])", txt, re.M)
    clock_on = bool(anim and anim.group(1) == "1") and st["on"]
    preconditions(clock_on, int(n.group(1)) if (n and st["on"]) else 0)
    if st["on"]:
        swap_in(out)
    else:
        set_shader(PASSTHROUGH)
    # Assert-set-assert. Around a config reload, Hyprland can reset the
    # preconditions AFTER the first assertion has landed but before (or as)
    # the shader compiles — the compile then sees the wrong damage tier and
    # raises the sticky red banner even though the value is corrected a
    # moment later. Restating after the swap means a late reset loses.
    txt2 = out.read_text()
    n2 = re.search(r"#define TUBE_COUNT\s+(\d+)", txt2)
    anim2 = re.search(r"^#define ANIMATED\s+([01])", txt2, re.M)
    clock_on2 = bool(anim2 and anim2.group(1) == "1") and st["on"]
    preconditions(clock_on2, int(n2.group(1)) if (n2 and st["on"]) else 0)
    # A banner the race above already latched does not clear itself: nothing
    # re-evaluates it, and the restated tier only stops the NEXT compile from
    # complaining. `hyprctl reload` was long believed the only way to take it
    # down; measured 2026-09-05, `hyprctl seterror disable` clears it
    # instantly, with none of a reload's amnesia. Only the clock can have
    # raised it from our compiles, so only then is the banner ours to close —
    # other error classes belong to hypr-error-watch, which toasts them from
    # its own probes and never by reading the bar.
    if clock_on2:
        hyprctl("seterror", "disable")
    # The forensic line. The error bar is raised at compile time and logged
    # nowhere, so a banner photographed hours later has nothing to subpoena.
    # This names every compile we cause — clock state, tier, tube count, with
    # a wall clock — so a picture of the bar plus its timestamp convicts one
    # specific swap, or acquits all of ours. `animated` here is the RENDERED
    # clock, so an ignition arc (which forces it on for 0.3 s while the stored
    # flag stays off) shows honestly as animated=1 for exactly those frames.
    import datetime as _dt
    fxn = re.search(r"#define FX_COUNT\s+(\d+)", txt2)
    print(f"crt: apply {_dt.datetime.now():%H:%M:%S} "
          f"animated={1 if clock_on2 else 0} on={int(st['on'])} "
          f"tubes={n2.group(1) if n2 else 0} fx={fxn.group(1) if fxn else 0}", flush=True)
    errs = (hyprctl("configerrors") or "").strip()
    if errs and "no errors" not in errs:
        print(errs, file=sys.stderr)


# -------------------------------------------------------------------- install


def strip_block(text):
    return re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", text, flags=re.S)


def install():
    HYPR.mkdir(parents=True, exist_ok=True)
    CRT_LUA.write_text(f"""{BEGIN}
-- The whole-desktop CRT. `crt` renders the shader from the template in the
-- plugin plus your knobs in $XDG_STATE_HOME/omarchy/crt/knobs.json.
--
-- This file is require()d from hyprland.lua AFTER hypr.looknfeel, so it wins
-- over a theme that also sets screen_shader. That ordering is the whole reason
-- the CRT can outlive a theme switch: the picture is the plugin's, the colours
-- come from whatever theme happens to be on.
local frag = "{SHADER}"
local probe = io.open(frag, "r")
if probe then
  probe:close()
  hl.config({{ decoration = {{ screen_shader = frag }} }})
end
{END}
""")

    if not HYPRLAND_LUA.exists():
        die(f"{HYPRLAND_LUA} does not exist — is this an Omarchy box?")
    text = HYPRLAND_LUA.read_text()
    if REQUIRE not in text:
        anchor = 'require("hypr.looknfeel")'
        if anchor in text:
            text = text.replace(anchor, anchor + "\n" + REQUIRE, 1)
        else:
            text = text.rstrip("\n") + "\n" + REQUIRE + "\n"
        HYPRLAND_LUA.write_text(text)
        print(f"wired {REQUIRE} into {HYPRLAND_LUA}")
    else:
        print(f"already wired into {HYPRLAND_LUA}")

    write_theme_hook()
    install_unit()
    st = load()
    commit(st)
    print(f"rendered {SHADER}")
    show(st)


def install_unit():
    """Put the watcher under systemd, pointing at THIS checkout.

    The unit template carries a %h path that is only right for the standard
    `omarchy plugin add` location, and the README told people to enable a unit
    systemd had never been shown. The installed copy gets its ExecStart written
    from where the plugin actually is, so a hand clone works the same.
    """
    if not shutil.which("systemctl"):
        print("systemctl not found — start the watcher yourself: crt tubes watch")
        return
    unit_dir = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "systemd/user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    text = (PLUGIN / "crt-tubes.service").read_text()
    text = re.sub(r"^ExecStart=.*$",
                  f"ExecStart={PLUGIN / 'crt'} tubes watch", text, flags=re.M)
    (unit_dir / "crt-tubes.service").write_text(text)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "crt-tubes.service"],
                   capture_output=True)
    print("watcher: crt-tubes.service installed and started")


def write_theme_hook():
    """Re-render when the theme changes, so the phosphor follows it.

    Omarchy runs every executable in hooks/theme-set.d/ after a theme switch.
    Without this the phosphor derived from a theme's accent would go stale the
    moment you switched away from it, and only catch up the next time somebody
    happened to run `crt` — which is to say, AUTO would be a setting that was
    true when you chose it and quietly wrong afterwards.
    """
    THEME_HOOK.parent.mkdir(parents=True, exist_ok=True)
    THEME_HOOK.write_text(f"""#!/bin/bash
# Installed by omarchy-crt's `crt install`.
#
# Omarchy passes the new theme's snake-cased name as $1; it is unused, because
# `crt render` reads the freshly staged colors.toml itself rather than trusting
# a name to map to a palette.
'{PLUGIN / "crt"}' render >/dev/null 2>&1
exit 0
""")
    THEME_HOOK.chmod(0o755)


def uninstall():
    if HYPRLAND_LUA.exists():
        text = HYPRLAND_LUA.read_text()
        if REQUIRE in text:
            HYPRLAND_LUA.write_text(re.sub(rf"^{re.escape(REQUIRE)}\n?", "", text, flags=re.M))
    CRT_LUA.unlink(missing_ok=True)
    THEME_HOOK.unlink(missing_ok=True)
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "disable", "--now", "crt-tubes.service"],
                       capture_output=True)
        unit = (Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
                / "systemd/user/crt-tubes.service")
        unit.unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    SHADER.unlink(missing_ok=True)
    write_passthrough()
    set_shader(PASSTHROUGH)
    print("uninstalled — knobs.json kept, so `crt install` picks up where you left off")


# ----------------------------------------------------------------------- show


def show(st):
    ch = theme_colours()
    print(f"  {'GLASS':<10} {'on' if st['on'] else 'off'}")
    print(f"  {'CLOCK':<10} {'running' if st.get('animated') else 'stopped'}"
          f"{'   (Hyprland redraws the whole screen every frame)' if st.get('animated') else ''}")
    # Every front-panel dial, taken from PANEL_DEFAULTS rather than listed
    # again here — a hardcoded triple survived SCANLINE being added and left
    # the fourth knob invisible to the command line while it worked fine on
    # the bar.
    for k in PANEL_DEFAULTS:
        v = st["panel"].get(k, PANEL_DEFAULTS[k])
        print(f"  {k:<10} {v:.2f}   {round(v * 100):>3d}%")
    print(f"  {'PHOSPHOR':<10} "
          f"{'from the staged theme' if ch else 'template default (no theme staged)'}")
    if st.get("passthrough"):
        print(f"  {'PASSTHRU':<10} " + ", ".join(st["passthrough"]))
    if st["service"]:
        print("\n  service panel:")
        for k in sorted(st["service"]):
            print(f"    {k:<14} {st['service'][k]}")
    print(f"\n  template {TEMPLATE}\n  state    {KNOBS}\n  shader   {SHADER}")


# ------------------------------------------------------------------------ cli


def main(argv):
    cmd = argv[0] if argv else "list"
    rest = argv[1:]

    if cmd in ("-h", "--help", "help"):
        print(__doc__.split("WHY THERE IS")[0].rstrip())
        return
    if cmd == "list":
        show(load())
        return
    if cmd == "install":
        # Installing on top of something that fights us produces a CRT that
        # works until a window moves. Say so and stop; `crt install --anyway`
        # is there for when you have read the reason and disagree.
        if any(c[0] == "fight" for c in conflicts()) and "--anyway" not in rest:
            doctor()
            print("crt: not installing over that. `crt install --anyway` overrides.",
                  file=sys.stderr)
            raise SystemExit(1)
        install()
        return
    if cmd == "uninstall":
        uninstall()
        return
    if cmd == "quiet":
        st = load()
        if rest:
            st["quietUnfocused"] = rest[0] not in ("off", "0", "false")
            commit(st)
        print("quiet on unfocused monitors: "
              + ("on" if st.get("quietUnfocused", True) else "off"))
        if rest:
            print("  run `crt tubes` (or let the watcher tick) to re-emit")
        return
    if cmd == "passthrough":
        st = load()
        if not rest:
            for c in st.get("passthrough", []):
                print(f"  {c}")
            if not st.get("passthrough"):
                print("  (nothing — every surface gets the glass)")
            return
        verb, names = rest[0], rest[1:]
        cur = list(st.get("passthrough", []))
        if verb == "add":
            cur += [n for n in names if n not in cur]
        elif verb in ("rm", "remove"):
            cur = [c for c in cur if c not in names]
        else:
            die("passthrough [add|rm] <window class>")
        st["passthrough"] = cur
        commit(st)
        print("passthrough: " + (", ".join(cur) or "(nothing)"))
        print("  run `crt tubes` (or let the watcher tick) to re-emit the rects")
        return
    if cmd == "tubes":
        if rest and rest[0] == "watch":
            tubes_watch()
        else:
            tubes_once()
        return
    if cmd == "doctor":
        raise SystemExit(doctor())
    if cmd == "try":
        raise SystemExit(try_on())
    if cmd == "untry":
        raise SystemExit(untry())

    st = load()

    if cmd == "render":
        # No hyprctl side effects: the theme-switch hook calls this, and a
        # theme switch is already reloading Hyprland.
        render(st)
        return
    if cmd == "set":
        if not rest or len(rest) % 2:
            die("set wants KNOB VALUE pairs")
        valid = known_knobs(template())
        named_clock = False
        for k, v in zip(rest[::2], rest[1::2]):
            k = k.upper()
            if k == "ANIMATED":
                st["animated"] = bool(float(v))
                st["service"].pop("ANIMATED", None)
                named_clock = True
                continue
            try:
                fv = float(v)
            except ValueError:
                die(f"'{v}' is not a number")
            # Turning a motion knob is the deliberate act that starts the
            # clock — and taking the last of them back to zero stops it, so
            # you never pay for a redraw nothing is using.
            if k in MOTION or (k in PANEL and k in MOTION):
                st["animated"] = st["animated"] or fv > 0.0
            if k in PANEL:
                st["panel"][k] = max(0.0, min(1.0, fv))
                # Turning a macro takes back the constants it owns, so the dial
                # and the picture cannot disagree about who is in charge.
                for const in PANEL[k]:
                    st["service"].pop(const, None)
            elif k in valid or k == "ANIMATED":
                st["service"][k] = fv
            else:
                die(f"no such knob: {k} (`crt` to list)")

        # And drop it again when nothing is left moving. This reads the values
        # a render WOULD produce, template defaults included, because a knob
        # nobody touched is not zero — FLICKER defaults to 0.35, and calling
        # that still counts as motion.
        #
        # Naming ANIMATED in the same breath outranks the inference. Someone
        # asking for a clock over a still picture has a reason (they are about
        # to turn something up), and silently overruling them in the same
        # command they typed it in is the tool arguing with its user.
        if st["animated"] and not named_clock:
            vals = expand(st)
            probe = template()
            for m in MOTION:
                if m not in vals:
                    hit = re.search(rf"^const float {m}\s*=\s*(-?[0-9.]+)", probe, re.M)
                    vals[m] = float(hit.group(1)) if hit else 0.0
            if not any(vals.get(m, 0.0) > 0.0 for m in MOTION):
                st["animated"] = False

        commit(st)
        show(st)
        return
    if cmd in ("on", "off"):
        st["on"] = cmd == "on"
        commit(st)
        print("glass on" if st["on"] else "glass lifted")
        return

    die(f"unknown command '{cmd}' — crt [list|set|on|off|doctor|try|untry|install|uninstall|render]")


if __name__ == "__main__":
    main(sys.argv[1:])
