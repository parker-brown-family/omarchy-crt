#!/usr/bin/env bash
# How long after a window event does the ignition flash appear? LIVE probe.
#
#   test/probe-fx-latency [n]     n open/close cycles (default 10)
#
# The one number the design could not settle by reading code: the delay between
# a window opening or closing and the swapped-in shader going live, since the
# clock only starts when the swap lands. It is the geometry snapshot (three
# hyprctl round trips), the render, the validate and the swap — all of which
# scale with how many windows are on screen, so it is measured on a real,
# populated desktop, not an empty workspace. FX_LEAD is tuned to it.
#
# The watch prints `fxtime <why> <ms>` per event under CRT_FX_TIME; this spawns
# and closes a marked window n times and reports the median of both halves.
#
# Isolated state and a single service stop/start, like probe-clock-reset — the
# real plugin state is untouched and the live watcher is handed back on exit.
set -uo pipefail

WT="$(cd "$(dirname "$0")/.." && pwd)"
N="${1:-10}"

need() { command -v "$1" >/dev/null || { echo "probe-fx-latency: $1 is required" >&2; exit 2; }; }
need hyprctl; need jq; need foot; need python3

TMPSTATE="$(mktemp -d)"
LOG="$TMPSTATE/watch.log"
export XDG_STATE_HOME="$TMPSTATE"
CRTSTATE="$TMPSTATE/omarchy/crt"
mkdir -p "$CRTSTATE"
cat >"$CRTSTATE/knobs.json" <<'JSON'
{ "on": true, "panel": {}, "service": { "IGNITION": 1.0 },
  "passthrough": ["terminal-delight"], "quietUnfocused": true, "animated": false }
JSON

prev_shader="$(hyprctl getoption decoration:screen_shader | awk '/^str:/{print $2}')"
prev_damage="$(hyprctl getoption debug:damage_tracking | awk '/^int:/{print $2}')"
prev_cursor="$(hyprctl getoption cursor:no_hardware_cursors | awk '/^int:/{print $2}')"
svc=""
if [[ "$(systemctl --user is-active crt-tubes.service 2>/dev/null)" == active ]]; then
  svc=1; systemctl --user stop crt-tubes.service; fi

WATCHPID=""
cleanup() {
  [[ -n "$WATCHPID" ]] && kill -TERM "$WATCHPID" 2>/dev/null
  sleep 0.6
  [[ -n "$prev_damage" ]] && hyprctl eval "hl.config({ debug = { damage_tracking = $prev_damage } })" >/dev/null
  [[ -n "$prev_cursor" ]] && hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $prev_cursor } })" >/dev/null
  hyprctl seterror disable >/dev/null 2>&1
  if [[ -n "$svc" ]]; then
    systemctl --user reset-failed crt-tubes.service 2>/dev/null
    systemctl --user start crt-tubes.service
  elif [[ -n "$prev_shader" && "$prev_shader" != "[[EMPTY]]" ]]; then
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$prev_shader\" } })" >/dev/null
  fi
}
trap cleanup EXIT

CRT_FX_TIME=1 CRT_WATCH_DEBUG=1 python3 "$WT/crt/crt" tubes watch >"$LOG" 2>&1 &
WATCHPID=$!
sleep 1.5

for i in $(seq 1 "$N"); do
  setsid foot sh -c 'sleep 30' >/dev/null 2>&1 &
  sleep 0.9
  ADDR="$(hyprctl clients -j | jq -r 'map(select(.class=="foot")) | sort_by(.focusHistoryID) | .[0].address // empty')"
  [[ -n "$ADDR" ]] && hyprctl dispatch "hl.dsp.window.close({ window = \"address:$ADDR\" })" >/dev/null 2>&1
  sleep 0.9
done

echo "=== $N cycles; per-event fxtime (ms) ==="
grep -oE 'fxtime (openwindow|closewindow) [0-9]+' "$LOG" | sort | uniq -c || true
python3 - "$LOG" <<'PY'
import sys, re, statistics
lines = open(sys.argv[1]).read().splitlines()
op = [int(m.group(1)) for l in lines if (m := re.search(r'fxtime openwindow (\d+)', l))]
cl = [int(m.group(1)) for l in lines if (m := re.search(r'fxtime closewindow (\d+)', l))]
def rep(name, xs):
    if xs:
        print(f"  {name:11s} n={len(xs):2d}  median={statistics.median(xs):.0f} ms  "
              f"min={min(xs)} max={max(xs)}")
    else:
        print(f"  {name:11s} no samples")
rep("open", op); rep("close", cl)
allx = op + cl
if allx:
    med = statistics.median(allx)
    print(f"\n  APPEARANCE latency (event -> flash on screen): median {med:.0f} ms.")
    print("  This is almost entirely the geometry snapshot that EVERY tube update")
    print("  already runs, not the flash. FX_LEAD covers only the render+swap after")
    print("  the arc is baked, so the arc still plays nearly in full — it just")
    print("  STARTS this many ms after the event.")
    if med > 120:
        print(f"  At {med:.0f} ms an OPEN flashes well after its window is already visible")
        print("  (a real pop); a CLOSE plays over vacated space, so the delay is invisible.")
        print("  -> Ship shutdown; hold ignition-on-open unless a close fast-path (bake the")
        print("     dying rect from the in-memory snapshot before re-running geometry) lands.")
    else:
        print("  -> Low enough that both halves read as immediate.")
PY
echo "LOG: $LOG"
