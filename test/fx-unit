#!/usr/bin/env python3
# Offline unit checks for the ignition watch's pure logic — the parts that
# decide WHICH surface flashes, WHEN, and what GLSL that bakes to, none of which
# needs a compositor. The live behaviour (a real open/close firing an arc) is
# proven by running the watch; this pins the arithmetic so a refactor cannot
# quietly break the offset re-baking or let the signature track the offsets.
#
#   test/fx-unit
#
# It loads crt/crt as a module (the file has no .py suffix, hence the explicit
# loader) and drives its functions against a scratch state dir.
import sys, re, tempfile
from pathlib import Path
from importlib.machinery import SourceFileLoader

REPO = Path(__file__).resolve().parent.parent
crt = SourceFileLoader("crt", str(REPO / "crt/crt")).load_module()

# Redirect state so nothing here touches the real one.
tmp = Path(tempfile.mkdtemp())
crt.STATE = tmp
crt.FX = tmp / "fx.glsl"

fails = []
def ok(cond, msg):
    print(("  ok   " if cond else "  FAIL ") + msg)
    if not cond:
        fails.append(msg)

# --- addresses reconcile across the two sources that name them ---
ok(crt.norm_addr("0x55d7") == "55d7", "norm_addr strips the 0x hyprctl uses")
ok(crt.norm_addr("55D7") == "55d7", "norm_addr lowercases")
ok(crt.norm_addr(None) == "", "norm_addr tolerates a missing address")

# --- eligibility: who may flash ---
st = {"passthrough": ["terminal-delight"], "quietUnfocused": True}
ok(not crt.fx_eligible({"curv": 0, "class": "foo", "mon": 0}, st, 0), "flat (curv 0) never flashes")
ok(not crt.fx_eligible({"curv": 0, "class": "terminal-delight", "mon": 0}, st, 0),
   "terminal-delight (curv 0, its own ignition) never flashes")
ok(not crt.fx_eligible({"curv": 1, "class": "terminal-delight", "mon": 0}, st, 0),
   "a passthrough class never flashes")
ok(not crt.fx_eligible({"curv": 1, "class": "kitty", "mon": 1}, st, 0),
   "an unfocused monitor never flashes while quiet")
ok(crt.fx_eligible({"curv": 1, "class": "kitty", "mon": 0}, st, 0),
   "curved, non-passthrough, focused DOES flash")
ok(crt.fx_eligible({"curv": 1, "class": "kitty", "mon": 1},
                   {"passthrough": [], "quietUnfocused": False}, 0),
   "an unfocused monitor flashes when quietUnfocused is off")
ok(crt.fx_eligible({"curv": 1, "class": "kitty", "mon": 0}, st, None),
   "an unknown focus gates nothing")

# --- the signature excludes the baked offset, or the watch loops forever ---
e = crt._fx_entry(0, {"mon": 0, "x": 0, "y": 0, "w": 100, "h": 50, "curv": 1}, 1000.0)
fx = {"aa": e}
sig = crt.fx_sig(fx)
crt.write_fx(fx, 1000.0);   b1 = crt.FX.read_text()
crt.write_fx(fx, 1000.15);  b2 = crt.FX.read_text()
ok(crt.fx_sig(fx) == sig, "fx_sig is stable as the wall clock advances")
ok(b1 != b2, "the baked FX_START DOES move between bakes (so the sig must not track it)")
s1 = float(re.search(r"FX_START\[FX_COUNT\] = float\[FX_COUNT\]\(([-0-9.]+)", b1).group(1))
s2 = float(re.search(r"FX_START\[FX_COUNT\] = float\[FX_COUNT\]\(([-0-9.]+)", b2).group(1))
ok(s1 < 0 and s2 < s1, "an aging arc's start offset grows more negative, so it keeps its place")
ok(abs(s1 - -crt.FX_LEAD) < 1e-6, "a fresh arc starts at -FX_LEAD to cover the swap latency")

# --- the baked block shape ---
ok("#define FX_COUNT 1" in b1, "the count is declared")
ok("FX_TINT[FX_COUNT]" in b1 and "FX_KIND[FX_COUNT]" in b1, "tint and kind arrays are baked")
ok("vec4(0.0, 0.0, 100.0, 50.0)" in b1, "the rect is baked as floats")
crt.write_fx({}, 2000.0); z = crt.FX.read_text()
ok("#define FX_COUNT 0" in z and "FX_RECT" not in z,
   "an empty table bakes count 0 and no arrays (GLSL forbids a zero-length one)")

# --- kind, and the newest-wins cap ---
ok(crt._fx_entry(1, {"mon": 0, "x": 0, "y": 0, "w": 1, "h": 1, "curv": 1}, 5.0)["kind"] == 1,
   "a shutdown entry carries kind 1")
many = {f"a{i}": crt._fx_entry(0, {"mon": 0, "x": 0, "y": 0, "w": 1, "h": 1, "curv": 1}, float(i))
        for i in range(20)}
keep = dict(sorted(many.items(), key=lambda kv: kv[1]["t0"])[-crt.FX_MAX:])
ok(len(keep) == crt.FX_MAX and "a19" in keep and "a0" not in keep,
   f"the storm cap keeps the newest {crt.FX_MAX} and drops the oldest")

# --- the knob is real, settable, and NOT a motion knob ---
kk = crt.known_knobs(crt.template())
ok("IGNITION" in kk, "IGNITION is a knob crt set can reach")
ok("IGNITION" not in crt.MOTION, "IGNITION is not a MOTION knob, so it never latches the clock")
ok(crt.ignition_level({"service": {"IGNITION": 1.0}}) == 1.0 and crt.ignition_level({}) == 0.0,
   "ignition_level reads the knob and defaults to 0")

# --- the duration knob: shader and watch must read the SAME arc length ---
ok("FX_S" in kk, "FX_S is a settable knob (crt set FX_S retimes the arc)")
ok(crt.fx_duration({}) == crt.FX_S_DEFAULT, "fx_duration defaults to TD's 0.30 s")
ok(crt.fx_duration({"service": {"FX_S": 0.9}}) == 0.9, "fx_duration reads the knob (3x slower)")
ok(crt.fx_duration({"service": {"FX_S": 9.0}}) == 3.0 and crt.fx_duration({"service": {"FX_S": 0.0}}) == 0.05,
   "fx_duration clamps a typo to a sane range")
ok("FX_S" not in crt.MOTION, "FX_S is not a MOTION knob")

print()
print("fx-unit: " + ("all green" if not fails else f"{len(fails)} FAILED"))
sys.exit(1 if fails else 0)
