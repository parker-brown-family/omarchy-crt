#!/usr/bin/env python3
"""Two pictures a person has to judge.  look-edges <state-dir> <out-dir>
A frame caught mid workspace slide, and a toast with real blur over a curved tile."""
import os, subprocess, sys, time
S, OUT = sys.argv[1], sys.argv[2]; HOME = S + "/home"; HERE = os.path.dirname(os.path.abspath(__file__))
os.makedirs(OUT, exist_ok=True)
def inn(*a): return subprocess.run([S + "/in", *a], capture_output=True, text=True, timeout=30)
def client(n): subprocess.Popen([S + "/in", "env", "QT_QPA_PLATFORM=wayland", "QS_NO_RELOAD_POPUP=1", "quickshell", "-p", f"{HOME}/client/{n}.qml"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
def shot(n):
    r = subprocess.run([HERE + "/shot", S, f"{OUT}/{n}.png"], capture_output=True, text=True, timeout=15)
    print(" ", n, r.stdout.strip() or r.stderr.strip(), flush=True)
open(HOME + "/keep-drawing", "w").close()
client("target")
for _ in range(60):
    if '"class"' in inn("hyprctl", "clients", "-j").stdout: break
    time.sleep(.25)
time.sleep(1.5)
print(inn("hyprctl", "eval", 'hl.config({ animations = { enabled = true } }); hl.curve("lin", { type = "bezier", points = { { 0, 0 }, { 1, 1 } } }); hl.animation({ leaf = "workspaces", enabled = true, speed = 40, bezier = "lin", style = "slide" })').stdout.strip()[:80])
inn("hyprctl", "dispatch", "hl.dsp.focus({ workspace = '2' })")
time.sleep(1.2)
shot("slide-mid")
time.sleep(4)
inn("hyprctl", "dispatch", "hl.dsp.focus({ workspace = '1' })"); time.sleep(5)
print(inn("hyprctl", "eval", 'hl.config({ animations = { enabled = false }, decoration = { blur = { enabled = true, size = 8, passes = 2 } } }); hl.layer_rule({ match = { namespace = "omarchy-notifications" }, blur = true })').stdout.strip()[:80])
client("toast"); time.sleep(3)
shot("toast-blur")
for n in ("target", "toast"): subprocess.run(["pkill", "-f", f"[q]uickshell -p {HOME}/client/{n}.qml"])
