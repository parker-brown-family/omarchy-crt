#!/usr/bin/env python3
"""The same rounded corner three ways.  look-corners <state-dir> <out-dir> [tag]"""
import json, os, shutil, subprocess, sys, time
S, OUT = sys.argv[1], sys.argv[2]; TAG = sys.argv[3] if len(sys.argv) > 3 else "x"
HOME = S + "/home"; HERE = os.path.dirname(os.path.abspath(__file__)); CRT = os.path.abspath(HERE + "/../../crt/crt")
os.makedirs(OUT, exist_ok=True)
def inn(*a): return subprocess.run([S + "/in", *a], capture_output=True, text=True, timeout=30)
sh = HOME + "/.state"; st = sh + "/omarchy"
os.makedirs(st + "/crt", exist_ok=True); os.makedirs(st + "/current/theme", exist_ok=True)
REAL = os.path.expanduser("~/.local/state/omarchy")
k = json.load(open(REAL + "/crt/knobs.json")); k.update(on=True, animated=False, passthrough=[])
json.dump(k, open(st + "/crt/knobs.json", "w")); shutil.copy(REAL + "/current/theme/colors.toml", st + "/current/theme/colors.toml")
open(HOME + "/keep-drawing", "w").close()
open(HOME + "/knobs.txt", "w").write("TUBE_K1 %.4f\nTUBE_K2 %.4f\nANIMATED 0\nON 1\n" % (k["panel"]["BARREL"] * .26, k["panel"]["BARREL"] * .11))
inn("hyprctl", "eval", 'hl.config({ decoration = { rounding = 14 }, general = { border_size = 2, gaps_in = 5, gaps_out = 10, col = { active_border = "rgba(ffd27fff)" } } })')
subprocess.Popen([S + "/in", "env", "QT_QPA_PLATFORM=wayland", "QS_NO_RELOAD_POPUP=1", "quickshell", "-p", f"{HOME}/client/target.qml"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
for _ in range(60):
    if '"class"' in inn("hyprctl", "clients", "-j").stdout: break
    time.sleep(.25)
time.sleep(1.5)
c = json.loads(inn("hyprctl", "clients", "-j").stdout)[0]
x, y = c["at"]; w, h = c["size"]
print("tile", x, y, w, h, flush=True)
g = f"{x + w - 140},{y - 10} 150x150"
def corner(name):
    time.sleep(1.0)
    r = inn("grim", "-g", g, "-s", "2", "-t", "ppm", f"{HOME}/corner.ppm")
    p = open(HOME + "/corner.ppm", "rb").read().split(b"\n", 3)
    frames.append((tuple(map(int, p[1].split())), p[3]))
frames = []
corner("native")
open(HOME + "/pass-off", "w").close(); time.sleep(.4)
corner("flat")
print(inn("env", f"XDG_STATE_HOME={sh}", "CRT_TUBES_ANYWAY=1", "python3", CRT, "tubes").stdout.strip()[:50])
corner("today")
inn("hyprctl", "eval", 'hl.config({ decoration = { screen_shader = "" } })'); os.unlink(HOME + "/pass-off")
subprocess.run(["pkill", "-f", f"[q]uickshell -p {HOME}/client/target.qml"])
# flat, native, today, side by side
import struct, zlib
(w, h), _ = frames[0]
order = [frames[1], frames[0], frames[2]]
rows = []
for y in range(h):
    r = b""
    for (fw, _), px in order:
        r += px[y*fw*3:(y+1)*fw*3] + b"\xff\xff\xff" * 12
    rows.append(r)
W = len(rows[0]) // 3
ch = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
open(f"{OUT}/{TAG}.png", "wb").write(b"\x89PNG\r\n\x1a\n" + ch(b"IHDR", struct.pack(">IIBBBBB", W, h, 8, 2, 0, 0, 0))
    + ch(b"IDAT", zlib.compress(b"".join(b"\0" + r for r in rows), 6)) + ch(b"IEND", b""))
print("wrote", W, h)
