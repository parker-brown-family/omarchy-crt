#!/usr/bin/env python3
"""Regenerate crt/tubes-geometry from the theme's td-tubes.

omarchy-crt needs one thing from omarchy-terminal-delight-theme: the code that
measures every visible surface and emits its rectangle — 400-odd lines of
hard-won jq covering monitor rotation, scale, layer surfaces, the fullscreen
occlusion rule and the whole-monitor budget. Reimplementing it would fork the
hardest logic in either repo; calling the theme's copy at runtime meant the
plugin only worked where the theme was installed, which defeats a plugin whose
argument is that it works on ANY theme.

So the plugin carries a generated copy, and THIS script is the only way that
copy changes. The theme's bin/td-tubes stays the single place the geometry is
edited; run this after pulling a theme change that touches it:

    bin/sync-tubes-geometry            # regenerates crt/tubes-geometry
    bin/sync-tubes-geometry --check    # exits 1 if the copy is stale

The copy is everything td-tubes defines up to its sourcing guard, minus the
line that sources td-monitor (whose helpers the geometry functions never call
— a die() shim covers the one exception). test/run proves the copy still
answers a stubbed compositor correctly, fullscreen occlusion included.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "crt/tubes-geometry"
UPSTREAM = Path.home() / "Work/omarchy-terminal-delight-theme/bin/td-tubes"

if not UPSTREAM.exists():
    sys.exit(f"sync-tubes-geometry: upstream not found at {UPSTREAM}")

src = UPSTREAM.read_text()

guard = 'if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0 2>/dev/null || true; fi'
if guard not in src:
    sys.exit("sync-tubes-geometry: td-tubes' sourcing guard not found — layout changed, update me")
body = src[:src.index(guard)]

# The td-monitor sourcing block: the geometry functions never call what it
# provides, except die(), which the prelude shims.
body = re.sub(
    r"# td-monitor stops at its own sourcing guard.*?\nsource \"\$TD_MONITOR\"\n",
    "", body, count=1, flags=re.S)
if 'source "$TD_MONITOR"' in body:
    sys.exit("sync-tubes-geometry: failed to cut the td-monitor source block")
body = body.replace("#!/usr/bin/env bash\n", "", 1)

commit = subprocess.run(
    ["git", "-C", str(UPSTREAM.parent.parent), "rev-parse", "--short", "HEAD"],
    capture_output=True, text=True).stdout.strip() or "unknown"

out = f"""#!/usr/bin/env bash
# GENERATED by bin/sync-tubes-geometry — do not edit. Edit the theme's
# bin/td-tubes and re-run the sync; this header records where the copy came
# from so staleness is checkable rather than a feeling.
#
#   upstream: omarchy-terminal-delight-theme/bin/td-tubes @ {commit}
#
# This file is SOURCE-ONLY: it defines tubes_json / cap / emit_block / describe
# and friends, and nothing here runs td-tubes' command line, its baker or its
# watcher. die() is shimmed because upstream takes it from td-monitor.
if [[ "${{BASH_SOURCE[0]}}" == "$0" ]]; then
  echo "tubes-geometry is a library — source it" >&2; exit 64
fi
die() {{ echo "tubes-geometry: $*" >&2; return 1; }}

{body}"""

if OUT.exists() and "--check" in sys.argv:
    old = re.sub(r"@ \w+", "@ X", OUT.read_text())
    new = re.sub(r"@ \w+", "@ X", out)
    if old == new:
        print("tubes-geometry: current")
        sys.exit(0)
    sys.exit("tubes-geometry: STALE — run bin/sync-tubes-geometry")

OUT.write_text(out)
OUT.chmod(0o755)
print(f"wrote {OUT} from td-tubes @ {commit} ({len(out.splitlines())} lines)")
